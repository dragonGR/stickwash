#!/usr/bin/env bash
set -euo pipefail

project_name="Stickwash"
selected_format_profile=""
selected_label=""
selected_partition_entry=""

say() {
  printf '%s\n' "$*"
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

have_command() {
  command -v "$1" >/dev/null 2>&1
}

need_root() {
  [[ ${EUID:-$(id -u)} -eq 0 ]] || die "Run this script as root. It needs real access to block devices."
}

need_tools() {
  local missing=()
  local tool

  for tool in lsblk findmnt umount wipefs parted partprobe udevadm mount mkdir chown; do
    have_command "$tool" || missing+=("$tool")
  done

  ((${#missing[@]} == 0)) || die "Missing tools: ${missing[*]}"

  if ! have_command mkfs.ext4 && ! have_command mkfs.exfat && ! have_command mkfs.fat && ! have_command mkfs.vfat; then
    die "Missing filesystem tools. Install e2fsprogs, exfatprogs, or dosfstools."
  fi
}

field() {
  local key=$1
  local line=$2
  local pattern

  pattern="${key}=\"([^\"]*)\""

  if [[ $line =~ $pattern ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi

  return 1
}

install_command_for_package() {
  local package=$1

  if have_command pacman; then
    printf 'sudo pacman -S %s\n' "$package"
  elif have_command apt-get; then
    printf 'sudo apt-get install %s\n' "$package"
  elif have_command dnf; then
    printf 'sudo dnf install %s\n' "$package"
  elif have_command zypper; then
    printf 'sudo zypper install %s\n' "$package"
  else
    printf 'Install package: %s\n' "$package"
  fi
}

discover_drives() {
  local line path rm tran size model serial kind

  while IFS= read -r line; do
    path=$(field PATH "$line") || continue
    rm=$(field RM "$line") || rm="0"
    tran=$(field TRAN "$line") || tran=""
    size=$(field SIZE "$line") || size="?"
    model=$(field MODEL "$line") || model=""
    serial=$(field SERIAL "$line") || serial=""
    kind=$(field TYPE "$line") || kind=""

    [[ $kind == "disk" ]] || continue
    [[ $rm == "1" || $tran == "usb" ]] || continue

    printf '%s|%s|%s|%s\n' "$path" "$size" "$model" "$serial"
  done < <(lsblk -dnP -o PATH,RM,TRAN,SIZE,MODEL,SERIAL,TYPE)
}

drive_title() {
  local entry=$1
  local path size model serial

  IFS='|' read -r path size model serial <<<"$entry"

  printf '%s  %s' "$path" "$size"

  if [[ -n $model ]]; then
    printf '  %s' "$model"
  fi

  if [[ -n $serial ]]; then
    printf '  [%s]' "$serial"
  fi

  printf '\n'
}

layout_snapshot() {
  local device=$1

  lsblk -o PATH,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$device"
}

show_layout() {
  local device=$1

  printf '\n'
  layout_snapshot "$device"
  printf '\n'
}

format_profiles() {
  if have_command mkfs.ext4; then
    printf '%s\n' "ext4|Linux default|mkfs.ext4|16|yes|e2fsprogs"
  else
    printf '%s\n' "ext4|Linux default|mkfs.ext4|16|no|e2fsprogs"
  fi

  if have_command mkfs.exfat; then
    printf '%s\n' "exFAT|Best for Linux and Windows|mkfs.exfat|15|yes|exfatprogs"
  else
    printf '%s\n' "exFAT|Best for Linux and Windows|mkfs.exfat|15|no|exfatprogs"
  fi

  if have_command mkfs.fat; then
    printf '%s\n' "FAT32|Widest support, 4 GB file limit|mkfs.fat|11|yes|dosfstools"
  elif have_command mkfs.vfat; then
    printf '%s\n' "FAT32|Widest support, 4 GB file limit|mkfs.vfat|11|yes|dosfstools"
  else
    printf '%s\n' "FAT32|Widest support, 4 GB file limit|mkfs.fat|11|no|dosfstools"
  fi
}

prompt_format_profile() {
  local choice index
  local profiles=()
  local name note tool limit available package

  mapfile -t profiles < <(format_profiles)

  while true; do
    say ""
    say "Pick a filesystem:"

    for index in "${!profiles[@]}"; do
      IFS='|' read -r name note tool limit available package <<<"${profiles[index]}"

      if [[ $available == "yes" ]]; then
        say "  $((index + 1)). $name  $note"
      else
        say "  $((index + 1)). $name  unavailable here"
        say "     $(install_command_for_package "$package")"
      fi
    done

    say "  q. back"
    read -r -p "Filesystem: " choice

    case "$choice" in
      q|Q|'')
        return 1
        ;;
    esac

    [[ $choice =~ ^[0-9]+$ ]] || {
      say "Pick a number or q."
      continue
    }

    if ((choice < 1 || choice > ${#profiles[@]})); then
      say "That filesystem number is out of range."
      continue
    fi

    IFS='|' read -r name note tool limit available package <<<"${profiles[choice - 1]}"

    if [[ $available == "yes" ]]; then
      selected_format_profile="${profiles[choice - 1]}"
      return 0
    fi

    say ""
    say "$name is not available on this machine yet."
    say "$(install_command_for_package "$package")"
  done
}

prompt_label() {
  local filesystem_name=$1
  local limit=$2
  local label

  while true; do
    read -r -p "$filesystem_name label, blank is fine: " label

    if ((${#label} <= limit)); then
      selected_label=$label
      return 0
    fi

    say "Keep the $filesystem_name label at $limit characters or less."
  done
}

format_partition() {
  local tool=$1
  local label=$2
  local part=$3

  case "$tool" in
    mkfs.ext4)
      if [[ -n $label ]]; then
        mkfs.ext4 -F -q -L "$label" "$part"
      else
        mkfs.ext4 -F -q "$part"
      fi
      ;;
    mkfs.exfat)
      if [[ -n $label ]]; then
        mkfs.exfat -q -L "$label" "$part"
      else
        mkfs.exfat -q "$part"
      fi
      ;;
    mkfs.fat|mkfs.vfat)
      if [[ -n $label ]]; then
        "$tool" -F 32 -n "$label" "$part" >/dev/null
      else
        "$tool" -F 32 "$part" >/dev/null
      fi
      ;;
    *)
      die "Unknown formatter: $tool"
      ;;
  esac
}

discover_partitions() {
  local device=$1
  local line path kind fstype label size mounts

  while IFS= read -r line; do
    path=$(field PATH "$line") || continue
    kind=$(field TYPE "$line") || kind=""
    fstype=$(field FSTYPE "$line") || fstype=""
    label=$(field LABEL "$line") || label=""
    size=$(field SIZE "$line") || size="?"
    mounts=$(field MOUNTPOINTS "$line") || mounts=""

    [[ $kind == "part" ]] || continue
    printf '%s|%s|%s|%s|%s\n' "$path" "$fstype" "$label" "$size" "$mounts"
  done < <(lsblk -lnP -o PATH,TYPE,FSTYPE,LABEL,SIZE,MOUNTPOINTS "$device")
}

partition_title() {
  local entry=$1
  local path fstype label size mounts

  IFS='|' read -r path fstype label size mounts <<<"$entry"

  printf '%s  %s' "$path" "$size"

  if [[ -n $fstype ]]; then
    printf '  %s' "$fstype"
  else
    printf '  unknown-fs'
  fi

  if [[ -n $label ]]; then
    printf '  [%s]' "$label"
  fi

  if [[ -n $mounts ]]; then
    printf '  mounted at %s' "$mounts"
  fi

  printf '\n'
}

label_profile_for_fstype() {
  local fstype=$1

  case "$fstype" in
    ext2|ext3|ext4)
      if have_command e2label; then
        printf '%s\n' "ext4|e2label|16|yes|e2fsprogs"
      else
        printf '%s\n' "ext4|e2label|16|no|e2fsprogs"
      fi
      ;;
    exfat)
      if have_command exfatlabel; then
        printf '%s\n' "exFAT|exfatlabel|15|yes|exfatprogs"
      else
        printf '%s\n' "exFAT|exfatlabel|15|no|exfatprogs"
      fi
      ;;
    fat|fat16|fat32|vfat|msdos)
      if have_command fatlabel; then
        printf '%s\n' "FAT32|fatlabel|11|yes|dosfstools"
      else
        printf '%s\n' "FAT32|fatlabel|11|no|dosfstools"
      fi
      ;;
    *)
      return 1
      ;;
  esac
}

relabel_partition() {
  local tool=$1
  local label=$2
  local part=$3

  case "$tool" in
    e2label|exfatlabel|fatlabel)
      "$tool" "$part" "$label"
      ;;
    *)
      die "Unknown label tool: $tool"
      ;;
  esac
}

prompt_partition_for_relabel() {
  local device=$1
  local choice index
  local parts=()

  mapfile -t parts < <(discover_partitions "$device")

  if ((${#parts[@]} == 0)); then
    say ""
    say "No partitions found on $device."
    return 1
  fi

  while true; do
    say ""
    say "Pick a partition to relabel:"

    for index in "${!parts[@]}"; do
      say "  $((index + 1)). $(partition_title "${parts[index]}")"
    done

    say "  q. back"
    read -r -p "Partition: " choice

    case "$choice" in
      q|Q|'')
        return 1
        ;;
    esac

    [[ $choice =~ ^[0-9]+$ ]] || {
      say "Pick a number or q."
      continue
    }

    if ((choice < 1 || choice > ${#parts[@]})); then
      say "That partition number is out of range."
      continue
    fi

    selected_partition_entry="${parts[choice - 1]}"
    return 0
  done
}

confirm_wipe() {
  local device=$1
  local mounted=()
  local mountpoint

  say ""
  say "This will permanently erase everything on $device."
  say ""

  # Check for mounted partitions
  while IFS= read -r mountpoint; do
    [[ -n $mountpoint ]] && mounted+=("$mountpoint")
  done < <(lsblk -ln -o MOUNTPOINTS "$device" | grep -v '^$')

  if ((${#mounted[@]} > 0)); then
    say ""
    say "These will be unmounted and destroyed:"
    printf '  • %s\n' "${mounted[@]}"
  fi

  show_layout "$device"

  read -r -p "Type the FULL device path ($device) to confirm: " typed
  [[ $typed == "$device" ]]
}

start_over_prompt() {
  local choice

  while true; do
    read -r -p "Press Enter to start over, or q to quit: " choice

    case "$choice" in
      '')
        return 0
        ;;
      q|Q)
        exit 0
        ;;
      *)
        say "Press Enter to start over, or q to quit."
        ;;
    esac
  done
}

unmount_partition_if_needed() {
  local part=$1

  if findmnt -rn -S "$part" >/dev/null 2>&1; then
    say "Unmounting $part"
    umount "$part"
  fi
}

unmount_children() {
  local device=$1
  local node
  local nodes=()

  mapfile -t nodes < <(lsblk -ln -o PATH "$device")

  for node in "${nodes[@]:1}"; do
    unmount_partition_if_needed "$node"
  done
}

first_partition() {
  local device=$1
  local -A before_nodes

  # Record existing nodes
  while IFS= read -r node; do
    before_nodes["$node"]=1
  done < <(lsblk -ln -o PATH "$device")

  for attempt in {1..10}; do
    while IFS= read -r node; do
      [[ -z ${before_nodes["$node"]} ]] && { printf '%s\n' "$node"; return 0; }
    done < <(lsblk -ln -o PATH "$device" | tail -n +2)

    partprobe "$device" >/dev/null 2>&1 || true
    udevadm settle >/dev/null 2>&1 || true
    sleep 1
  done
  return 1
}

safe_mount_leaf() {
  local text=$1

  text=${text// /_}
  text=${text//[^[:alnum:]_.-]/_}
  text=${text#_}
  text=${text%_}

  if [[ -z $text ]]; then
    text="usb-stick"
  fi

  printf '%s\n' "$text"
}

mount_partition_for_user() {
  local part=$1
  local filesystem_name=$2
  local label=$3
  local mount_leaf base mountpoint uid gid
  local user_name=${SUDO_USER:-}

  if [[ -n $label ]]; then
    mount_leaf=$(safe_mount_leaf "$label")
  else
    mount_leaf=$(safe_mount_leaf "${part##*/}")
  fi

  if [[ -n $user_name && $user_name != root ]]; then
    base="/run/media/$user_name"
  else
    base="/mnt"
  fi

  mountpoint="$base/$mount_leaf"
  mkdir -p "$mountpoint"

  if [[ -n $user_name && $user_name != root ]]; then
    uid=$(id -u "$user_name")
    gid=$(id -g "$user_name")
  else
    uid=$(id -u)
    gid=$(id -g)
  fi

  case "$filesystem_name" in
    exFAT|FAT32)
      mount -o "uid=$uid,gid=$gid,umask=022" "$part" "$mountpoint"
      ;;
    ext4)
      mount "$part" "$mountpoint"
      chown "$uid:$gid" "$mountpoint"
      ;;
    *)
      mount "$part" "$mountpoint"
      ;;
  esac

  printf '%s\n' "$mountpoint"
}

show_result_summary() {
  local headline=$1
  local before_layout=$2
  local after_layout=$3
  local filesystem_name=$4
  local label=$5
  local part=$6

  say ""
  say "$headline"
  say "Filesystem: $filesystem_name"
  say "Partition: $part"

  if [[ -n $label ]]; then
    say "Label: $label"
  else
    say "Label: none"
  fi

  say ""
  say "Before:"
  printf '%s\n' "$before_layout"
  say ""
  say "Now:"
  printf '%s\n' "$after_layout"
  say ""
}

after_format_menu() {
  local part=$1
  local filesystem_name=$2
  local label=$3
  local mountpoint choice
  local mounted="no"

  while true; do
    if [[ $mounted == "no" ]]; then
      say "What next:"
      say "  1. Mount it now"
      say "  2. Start over"
      say "  3. Quit"
      read -r -p "Choice: " choice

      case "$choice" in
        1)
          mountpoint=$(mount_partition_for_user "$part" "$filesystem_name" "$label")
          say ""
          say "$part is mounted at $mountpoint"
          if [[ $filesystem_name == "ext4" ]]; then
            say "Stickwash also handed the root of that filesystem to your user."
          fi
          say ""
          mounted="yes"
          ;;
        2)
          return 0
          ;;
        3|q|Q)
          exit 0
          ;;
        *)
          say "Pick 1, 2, or 3."
          ;;
      esac
    else
      say "What next:"
      say "  1. Start over"
      say "  2. Quit"
      read -r -p "Choice: " choice

      case "$choice" in
        1)
          return 0
          ;;
        2|q|Q)
          exit 0
          ;;
        *)
          say "Pick 1 or 2."
          ;;
      esac
    fi
  done
}

wipe_and_make_filesystem() {
  local device=$1
  local filesystem_name=$2
  local formatter=$3
  local label=$4
  local root_source part node before_layout after_layout
  local nodes=()

  root_source=$(findmnt -no SOURCE / 2>/dev/null || true)
  if [[ -n $root_source && $root_source == "$device"* ]]; then
    die "Refusing to touch the drive that backs /."
  fi

  before_layout=$(layout_snapshot "$device")

  confirm_wipe "$device" || {
    say "Cancelled."
    return 0
  }

  unmount_children "$device"

  mapfile -t nodes < <(lsblk -ln -o PATH "$device")
  for node in "${nodes[@]:1}"; do
    wipefs -af "$node" >/dev/null 2>&1 || true
  done

  wipefs -af "$device" >/dev/null
  parted -s "$device" mklabel gpt
  parted -s "$device" mkpart primary 1MiB 100%
  partprobe "$device"
  udevadm settle

  part=$(first_partition "$device") || die "The new partition did not show up."
  format_partition "$formatter" "$label" "$part"

  partprobe "$device" >/dev/null 2>&1 || true
  udevadm settle >/dev/null 2>&1 || true

  after_layout=$(layout_snapshot "$device")

  show_result_summary "$device has been formatted as $filesystem_name." "$before_layout" "$after_layout" "$filesystem_name" "$label" "$part"
  after_format_menu "$part" "$filesystem_name" "$label"
}

change_label_only() {
  local device=$1
  local path fstype old_label size mounts
  local filesystem_name label_tool label_limit available package before_layout after_layout

  prompt_partition_for_relabel "$device" || return 0
  IFS='|' read -r path fstype old_label size mounts <<<"$selected_partition_entry"

  if ! label_profile_for_fstype "$fstype" >/dev/null 2>&1; then
    say ""
    say "$path uses $fstype. Stickwash does not know how to relabel that filesystem yet."
    return 0
  fi

  IFS='|' read -r filesystem_name label_tool label_limit available package <<<"$(label_profile_for_fstype "$fstype")"

  if [[ $available != "yes" ]]; then
    say ""
    say "Relabel support for $filesystem_name is not installed here."
    say "$(install_command_for_package "$package")"
    return 0
  fi

  prompt_label "$filesystem_name" "$label_limit"
  before_layout=$(layout_snapshot "$device")

  unmount_partition_if_needed "$path"
  relabel_partition "$label_tool" "$selected_label" "$path"
  udevadm settle >/dev/null 2>&1 || true
  after_layout=$(layout_snapshot "$device")

  show_result_summary "$path has a new label." "$before_layout" "$after_layout" "$filesystem_name" "$selected_label" "$path"
  start_over_prompt
}

drive_menu() {
  local entry=$1
  local device choice
  local filesystem_name note formatter label_limit available package

  IFS='|' read -r device _ <<<"$entry"

  while true; do
    say ""
    say "Picked: $(drive_title "$entry")"
    say "  1. Show current layout"
    say "  2. Change label only"
    say "  3. Wipe it and format it"
    say "  4. Back to the drive list"

    read -r -p "What now: " choice

    case "$choice" in
      1)
        show_layout "$device"
        ;;
      2)
        change_label_only "$device"
        return 0
        ;;
      3)
        prompt_format_profile || continue
        IFS='|' read -r filesystem_name note formatter label_limit available package <<<"$selected_format_profile"
        prompt_label "$filesystem_name" "$label_limit"
        wipe_and_make_filesystem "$device" "$filesystem_name" "$formatter" "$selected_label"
        return 0
        ;;
      4)
        return 0
        ;;
      *)
        say "Pick 1, 2, 3, or 4."
        ;;
    esac
  done
}

main() {
  local choice index
  local drives=()

  need_root
  need_tools

  say "$project_name"
  say ""
  say "This script only lists removable USB drives."
  say ""

  while true; do
    mapfile -t drives < <(discover_drives)

    if ((${#drives[@]} == 0)); then
      read -r -p "No removable USB drives found. Press Enter to scan again, or q to quit: " choice
      [[ $choice == "q" || $choice == "Q" ]] && exit 0
      continue
    fi

    say "Drives on this machine:"
    for index in "${!drives[@]}"; do
      say "  $((index + 1)). $(drive_title "${drives[index]}")"
    done
    say "  r. scan again"
    say "  q. quit"

    read -r -p "Pick a drive: " choice

    case "$choice" in
      q|Q)
        exit 0
        ;;
      r|R|'')
        continue
        ;;
    esac

    [[ $choice =~ ^[0-9]+$ ]] || {
      say "Pick a number, r, or q."
      continue
    }

    if ((choice < 1 || choice > ${#drives[@]})); then
      say "That drive number is out of range."
      continue
    fi

    drive_menu "${drives[choice - 1]}"
  done
}

main "$@"
